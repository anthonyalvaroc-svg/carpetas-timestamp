<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtCarpetaActiva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Carpeta seleccionada: Ninguna"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/btnNuevaCarpeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Crear nueva carpeta" />

    <ListView
        android:id="@+id/listCarpetas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="12dp" />

    <Button
        android:id="@+id/btnTomarFoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tomar foto con Timestamp" />

    <Button
        android:id="@+id/btnZipCompartir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Comprimir ZIP y Compartir / Subir" />

</LinearLayout>
